# Eco-Points RVM Edge Client Configuration Template
# Copy this file to '.env' and fill in your values

# The URL of the cloud backend server
BACKEND_URL=http://127.0.0.1:5000

# Unique identifier for this Reverse Vending Machine (RVM) unit
MACHINE_ID=RVM-PU-01

# The physical location where the machine is deployed
LOCATION=Institute of Technology

# Set to true to run the firmware in CLI/Terminal mode (no UI required)
# Set to false to run in UI-driven mode (WebSocket UI required)
CLI_MODE=false

# The RVM's API key for authenticating requests to the backend
API_KEY=your_api_key_here

# The organization's QR HMAC secret (hex string), used to sign user IDs during scan simulations
QR_HMAC_SECRET=your_qr_hmac_secret_here

# USB hub locations (comma-separated) to power off/on using uhubctl.
# On Raspberry Pi 5, ports are ganged across hubs 3 and 4 (or 1 and 3 depending on OS).
# Toggling both locations cuts power to the ganged rail, turning off the QR Scanner LED.
UHUBCTL_LOCATIONS=3,4

# Specific port to switch on the above hubs (leave blank to switch all ports)
UHUBCTL_PORT=
