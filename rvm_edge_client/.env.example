# Eco-Points RVM Edge Client — Environment Configuration Example
# Copy this file to .env and fill in the values for your deployment.

# How many steps to rotate the motor when dropping a bottle (default is 1000, 1250 is ~90 degrees)
MOTOR_OPEN_STEPS=1000

# URL of the EcoPoints backend API (no trailing slash)
# Format: https://<host> or http://<host>:<port>
# Example: https://api.ecopoints.org
BACKEND_URL=https://api.ecopoints.org

# Unique identifier for this Reverse Vending Machine unit
# Format: any string; recommended pattern RVM-<SITE>-<UNIT>
# Example: RVM-EPTU-SEED-001
MACHINE_ID=RVM-EPTU-SEED-001

# Human-readable physical location where the machine is deployed
# Format: free text string
# Example: Gymnasium
LOCATION=Gymnasium

# API key used to authenticate firmware requests to the backend (X-API-Key header)
# Format: URL-safe base64 string issued by the backend
# Placeholder — replace with real key before deploying; this value will not pass backend auth
API_KEY=your_api_key_here

# HMAC secret used to sign/verify QR code payloads during scan simulations
# Format: hex string (64 hex characters = 32-byte key)
# Placeholder — replace with real secret before deploying; this value will not pass backend auth
QR_HMAC_SECRET=your_qr_hmac_secret_here

# Run firmware in CLI/Terminal mode (no WebSocket UI required)
# Format: boolean string — true or false
# Default: false
CLI_MODE=false

# Disable all GPIO hardware access (useful for development/testing without Raspberry Pi hardware)
# Format: boolean string — true or false
# Default: false (set to true on non-Pi development machines)
DISABLE_GPIO=false

# Comma-separated list of uhubctl hub location identifiers for USB power cycling
# Format: comma-separated integers, e.g. 1,2 — may be left empty if uhubctl is not used
# Example: 1,2
UHUBCTL_LOCATIONS=

# USB port number targeted by uhubctl for power cycling
# Format: integer — may be left empty if uhubctl is not used
# Example: 2
UHUBCTL_PORT=
