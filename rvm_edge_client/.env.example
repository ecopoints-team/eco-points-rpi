# Eco-Points RVM Edge Client Configuration Template
# Copy this file to '.env' and fill in your values

# The URL of the cloud backend server
BACKEND_URL=http://127.0.0.1:5000

# Unique identifier for this Reverse Vending Machine (RVM) unit
MACHINE_ID=RVM-PU-01

# The physical location where the machine is deployed
LOCATION=Institute of Technology

# Set to true to run the firmware in CLI/Terminal mode (no UI required)
# Set to false to run in UI-driven mode (WebSocket UI required)
CLI_MODE=false
